{
  "name": "drpratchaya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "typecheck": "astro check && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "index:search": "tsx scripts/reindex-search.ts",
    "verify:search": "tsx scripts/verify-search-corpus.ts",
    "db:seed:dev": "wrangler d1 execute drpratchaya-db --local --file=scripts/seed-dev-booking-fixtures.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@cloudflare/puppeteer": "^1.4.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "workerd@1.20260114.0": true,
    "workerd@1.20260918.1": true
  }
}
