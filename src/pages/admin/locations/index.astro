---
export const prerender = false;
import AdminShell from '~/components/admin/AdminShell.astro';
import { requireAdminPage, redirectToLogin } from '~/lib/auth/guard';
import { env } from 'cloudflare:workers';
import { listLocations } from '~/lib/admin/locations';

const auth = await requireAdminPage(Astro.request);
if (!auth) return redirectToLogin();
const locations = await listLocations(env.DB);
---

<AdminShell title="สถานที่" email={auth.user.email} csrfToken={auth.session.csrfToken} active="locations">
  <ul class="space-y-3">
    {
      locations.map((l) => (
        <li class="rounded-2xl border border-rule bg-white p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="font-head text-subhead font-semibold">{l.name_th}</p>
              <p class="text-meta text-text-2">{l.name_en} · {l.booking_mode}</p>
            </div>
            <a
              href={`/admin/locations/${l.id}/`}
              class="inline-flex min-h-11 items-center justify-center rounded-xl bg-teal-deep px-4 text-meta font-medium text-white"
            >
              ตาราง / แก้ไข
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</AdminShell>
