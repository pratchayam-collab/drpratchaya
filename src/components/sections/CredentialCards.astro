---
/**
 * Direction B: four distinct credential cards (IOC, FIFA, SEA Games, KSES).
 * Gold appears only as the top rule on each card — never as text.
 */
import { credentials, type Locale } from '~/config/site.config';
import { ui } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section class="cred-cards" aria-label={t.credentialsKicker}>
  <div class="page">
    <p class="kicker cred-cards-kicker">{t.credentialsKicker}</p>
    <ul class="cred-cards-grid">
      {
        credentials.map((credential) => (
          <li class="cred-card">
            <span class="cred-card-abbr">{credential.abbr}</span>
            <span class="cred-card-title">{credential.title[locale]}</span>
            <span class="cred-card-detail">{credential.detail[locale]}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cred-cards {
    padding-block: 2.5rem 2rem;
    background: var(--teal-wash);
    border-block: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .cred-cards {
      padding-block: 3rem 2.5rem;
    }
  }

  .cred-cards-kicker {
    margin-bottom: 1.25rem;
  }

  .cred-cards-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 520px) {
    .cred-cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 960px) {
    .cred-cards-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .cred-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.125rem 1.25rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    border-top: 2px solid var(--gold);
  }

  .cred-card-abbr {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    color: var(--teal-deep);
  }

  .cred-card-title {
    font-family: var(--font-head);
    font-size: var(--text-subhead);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }

  .cred-card-detail {
    font-size: var(--text-meta);
    line-height: 1.6;
    color: var(--text-2);
  }
</style>
