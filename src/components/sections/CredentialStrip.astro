---
/**
 * The credential strip — the only place `--gold` appears in the whole site.
 *
 * Gold is a 2px rule above each item, never a text colour: gold on cream is
 * 3.08:1, which fails AA for text but clears the 3:1 required of a non-text
 * graphical element. The abbreviation and title are set in `--ink`.
 *
 * The band deliberately stays on cream rather than the teal wash. Gold on the
 * wash measures 2.98:1 and would sit just under that 3:1 threshold, and a pair
 * of hairline rules separates the band more quietly than a tint — which is the
 * journal treatment this page is after.
 */
import { credentials, type Locale } from '~/config/site.config';
import { ui } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section class="strip" aria-label={t.credentialsKicker}>
  <div class="page">
    <ul class="strip-list">
      {
        credentials.map((credential) => (
          <li class="strip-item">
            <span class="strip-abbr">{credential.abbr}</span>
            <span class="strip-title">{credential.title[locale]}</span>
            <span class="strip-detail">{credential.detail[locale]}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .strip {
    border-block: 1px solid var(--border);
    background: var(--surface);
    padding-block: 2rem;
  }

  .strip-list {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 700px) {
    .strip-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    /* The single sanctioned use of gold. */
    border-top: 2px solid var(--gold);
    padding-top: 0.875rem;
  }

  .strip-abbr {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    color: var(--teal-deep);
  }

  .strip-title {
    font-family: var(--font-head);
    font-size: var(--text-subhead);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }

  .strip-detail {
    font-size: var(--text-meta);
    color: var(--text-2);
  }
</style>
