---
/**
 * Sticky header: wordmark, section navigation, language switch, appointment CTA.
 *
 * Mobile navigation is a native `<details>` disclosure rather than a scripted
 * drawer, so it is keyboard-operable and works before any JavaScript runs.
 */
import { doctor, nav, type Locale } from '~/config/site.config';
import { localePath, ui } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const home = localePath(locale);
const thHome = localePath('th');
const enHome = localePath('en');
---

<header class="site-header">
  <div class="page header-inner">
    <a href={home} class="wordmark">
      <span class="wordmark-name">{doctor.name[locale]}</span>
      <span class="wordmark-role">{doctor.specialty[locale]}</span>
    </a>

    <nav class="nav-desktop" aria-label={t.menu}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.hash}>{item.label[locale]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={t.langSwitchLabel}>
        <a href={thHome} aria-current={locale === 'th' ? 'page' : undefined} lang="th">
          {t.thai}
        </a>
        <span class="lang-divider" aria-hidden="true"></span>
        <a href={enHome} aria-current={locale === 'en' ? 'page' : undefined} lang="en">
          {t.english}
        </a>
      </div>

      <a href="#appointment" class="btn btn-primary header-cta">{t.book}</a>

      <details class="nav-mobile">
        <summary aria-label={t.menu}>
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <div class="nav-mobile-panel">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.hash}>{item.label[locale]}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile disclosure after an in-page jump, so the panel does not
  // stay open over the section the reader just asked for.
  const menu = document.querySelector<HTMLDetailsElement>('details.nav-mobile');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.open = false;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    min-height: 2.75rem;
    padding-block: 0.375rem;
    color: var(--ink);
    margin-inline-end: auto;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .wordmark-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  /* The Thai specialty line wraps to two lines in a narrow header, and the
     hero repeats it immediately below, so it is withheld on small screens. */
  .wordmark-role {
    display: none;
    font-size: var(--text-micro);
    line-height: 1.45;
    color: var(--text-2);
  }

  @media (min-width: 480px) {
    .wordmark-role {
      display: block;
    }
  }

  @media (max-width: 1023px) {
    .nav-desktop {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-desktop a {
    font-size: var(--text-meta);
    font-weight: 500;
    color: var(--text);
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .nav-desktop a:hover {
    color: var(--teal-deep);
    border-bottom-color: var(--teal-deep);
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-micro);
  }

  .lang-switch a {
    color: var(--text-2);
    font-weight: 500;
    min-height: 2.75rem;
    min-width: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 0.375rem;
  }

  .lang-switch a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .lang-divider {
    width: 1px;
    height: 0.875rem;
    background: var(--border);
  }

  /* The header CTA is redundant with the mobile dock, so it only appears once
     the dock is gone. */
  .header-cta {
    display: none;
  }

  /* Mobile disclosure menu */
  .nav-mobile summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.125rem;
    height: 1px;
    background: var(--ink);
    content: '';
  }

  .bars {
    position: relative;
  }

  .bars::before {
    position: absolute;
    top: -0.3125rem;
  }

  .bars::after {
    position: absolute;
    top: 0.3125rem;
  }

  .nav-mobile-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1.25rem 1rem;
  }

  .nav-mobile:not([open]) .nav-mobile-panel {
    display: none;
  }

  .nav-mobile-panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-meta);
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }

  .nav-mobile-panel li:last-child a {
    border-bottom: 0;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: block;
    }

    .nav-mobile {
      display: none;
    }

    .header-cta {
      display: inline-flex;
    }
  }
</style>
